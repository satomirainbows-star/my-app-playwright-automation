{
  "name": "my-app-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright + Cucumber QA Automation Framework",
  "main": "index.js",
  "scripts": {
    "test:all": "cucumber-js \"features/**/*.feature\" --require \"step_definitions/**/*.js\" --require \"support/**/*.js\" --format progress --format json:reports/json/report.json && node generate-report.js",
    "test:ui": "cucumber-js \"features/ui/**/*.feature\" --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:api": "cucumber-js \"features/api/**/*.feature\" --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:positive": "cucumber-js --tags '@Positive' --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:negative": "cucumber-js --tags '@Negative' --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:ui-only": "cucumber-js --tags '@UI' --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:api-only": "cucumber-js --tags '@API' --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:smoke": "cucumber-js --tags \"@smoke\" --require \"step_definitions/**/*.js\" --require \"support/**/*.js\"",
    "test:regression": "cucumber-js --tags \"@regression\" --require \"step_definitions/**/*.js\" --require \"support/**/*.js\""

  },
  "dependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.53.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "multiple-cucumber-html-reporter": "^3.10.0"
  }
}
